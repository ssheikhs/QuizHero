# Copy this file to .env.local and fill in the values.  Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=quizhero

# BetterAuth — a long random string (generate one with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
# The site's URL. http://localhost:3000 locally, your Vercel URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Code that lets someone sign up as an Instructor. Leave empty to disable instructor sign-ups.
INSTRUCTOR_INVITE_CODE=

# Password for the demo accounts created by `npm run seed` (8+ chars, uppercase, number, symbol).
# Leave empty to seed categories only. If the value contains #, wrap it in quotes ("...").
SEED_PASSWORD=
